# Sound Pesa Mobile - Expo environment
# `make setup-env` copies this to .env. Vars must be EXPO_PUBLIC_ to be inlined client-side.

# API base URL (Django backend)
EXPO_PUBLIC_API_URL=http://localhost:8000/api
# WebSocket URL for live updates
EXPO_PUBLIC_WS_URL=ws://localhost:8000/ws

# --- App identity ---
EXPO_PUBLIC_APP_NAME=Sound Pesa
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_DEV_MODE=true

# --- Alchemy (Ethereum/Solana node access) ---
EXPO_PUBLIC_ALCHEMY_ETH_URL=https://eth-sepolia.g.alchemy.com/v2/
EXPO_PUBLIC_ALCHEMY_ETH_KEY=
EXPO_PUBLIC_ALCHEMY_SOCKET_URL=wss://eth-mainnet.g.alchemy.com/v2/
EXPO_PUBLIC_ALCHEMY_SOL_URL=https://solana-mainnet.g.alchemy.com/v2/
EXPO_PUBLIC_ALCHEMY_SOL_API_KEY=