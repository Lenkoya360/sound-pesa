# Sound Pesa Web - Next.js environment
# `make setup-env` copies this to .env.local. Vars must be NEXT_PUBLIC_ to be bundled client-side.

# API base URL (Django backend)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# WebSocket URL for live updates
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# VAPID public key for web push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- App identity ---
NEXT_PUBLIC_APP_NAME=Sound Pesa
NEXT_PUBLIC_APP_DESCRIPTION=Multi-chain decentralized wallet and P2P exchange
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_PWA_NAME=Sound Pesa
NEXT_PUBLIC_PWA_SHORT_NAME=Sound Pesa
NEXT_PUBLIC_PWA_DESCRIPTION=Multi-chain decentralized wallet and P2P exchange
NEXT_PUBLIC_ENABLE_PWA=true

# --- Feature flags ---
NEXT_PUBLIC_ENABLE_2FA=true
NEXT_PUBLIC_ENABLE_BIOMETRIC_AUTH=true
NEXT_PUBLIC_MOCK_API=false
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_SESSION_TIMEOUT=30            # minutes
NEXT_PUBLIC_JWT_REFRESH_THRESHOLD=300     # seconds before expiry to refresh

# --- Networks (display/validation) ---
NEXT_PUBLIC_BITCOIN_NETWORK=testnet
NEXT_PUBLIC_ETHEREUM_NETWORK=sepolia
NEXT_PUBLIC_CARDANO_NETWORK=testnet
NEXT_PUBLIC_POLKADOT_NETWORK=westend

# --- Observability (optional) ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_ID=