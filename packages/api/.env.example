# Sound Pesa API - Django environment
# Copy to .env before running the API. Values here mirror sound_pesa/settings/base.py defaults.

DJANGO_SETTINGS_MODULE=sound_pesa.settings.development

# Security: override in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Postgres ---
POSTGRES_DB=soundpesa
POSTGRES_USER=soundpesa
POSTGRES_PASSWORD=devpassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=600

# --- Redis / Celery ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME=60        # minutes
JWT_REFRESH_TOKEN_LIFETIME=7        # days
JWT_ALGORITHM=HS256
# Leave blank to default to SECRET_KEY
JWT_SECRET_KEY=

# --- CORS (comma-separated origins) ---
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Vault (wallet key management) ---
VAULT_URL=http://localhost:8200
VAULT_TOKEN=dev-token
VAULT_NAMESPACE=sound-pesa

# --- Blockchain node connections ---
BITCOIN_NETWORK=testnet
BITCOIN_RPC_URL=http://localhost:18332
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=password

ETHEREUM_NETWORK=sepolia
ETHEREUM_RPC_URL=http://localhost:8545
ETHEREUM_WS_URL=ws://localhost:8546

CARDANO_NETWORK=testnet
CARDANO_NODE_SOCKET=/opt/cardano/db/socket

POLKADOT_NETWORK=westend
POLKADOT_WS_URL=ws://localhost:9944

# --- Logging ---
DJANGO_LOG_LEVEL=INFO