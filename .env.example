# Sound Pesa Platform - Infrastructure environment
# Copy to .env and adjust before running `make setup-env` or docker compose.
# These values are shared by the docker compose services and deploy scripts.

# --- Deployment ---
ENVIRONMENT=development            # development | staging | production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
COMPOSE_PROJECT_NAME=sound-pesa
DOMAIN=localhost
LETSENCRYPT_EMAIL=

# --- Django ---
# Keep SECRET_KEY secret. Use `python -c "import secrets; print(secrets.token_urlsafe(64))"`.
SECRET_KEY=dev-secret-key-change-in-production
DJANGO_SECRET_KEY=dev-secret-key-change-in-production

# --- Postgres ---
POSTGRES_DB=soundpesa
POSTGRES_USER=soundpesa
POSTGRES_PASSWORD=devpassword

# --- Redis / Celery ---
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME=60        # minutes
JWT_REFRESH_TOKEN_LIFETIME=7        # days
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=

# --- Vault (secret storage for wallet keys) ---
VAULT_URL=http://vault:8200
VAULT_TOKEN=dev-token
VAULT_DEV_ROOT_TOKEN_ID=dev-root-token
VAULT_DEV_LISTEN_ADDRESS=0.0.0.0:8200

# --- Backups / deploys ---
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=7
DEPLOY_DIR=/opt/sound-pesa